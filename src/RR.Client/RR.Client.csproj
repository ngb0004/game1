<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Engine-agnostic presentation logic: input mapping (bar swap, time to tick),
    HUD state built from sim events, and the fight session wrapper.
    Ports into Unity's RR.Game assembly unchanged (see RR.Client.asmdef).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>RR.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RR.Sim\RR.Sim.csproj" />
  </ItemGroup>

</Project>
